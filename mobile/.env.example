# BeatzClik Fan Mobile — environment example
# Copy to .env for local dev or pass via --dart-define
# API origin must include scheme and host, without trailing /v1
# Production default is https://api.beatzclik.com
# Local backend (Quarkus dev):
# API_ORIGIN=http://127.0.0.1:8080
API_ORIGIN=https://api.beatzclik.com

# Optional: override for e2e / staging
# API_ORIGIN=https://staging.api.beatzclik.com
